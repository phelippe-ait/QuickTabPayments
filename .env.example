# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). .env.local is git-ignored.
#
# Only ever put the *publishable/anon* key here. It is safe to ship in the
# browser. Never put the service_role / secret key in a VITE_ variable.

# Base project URL only — e.g. https://<project-ref>.supabase.co
# Do NOT include a trailing slash or the REST endpoint (/rest/v1), or you'll get
# "Invalid path specified in request URL".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
